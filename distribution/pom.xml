<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.kosit</groupId>
        <artifactId>validator-parent</artifactId>
        <version>2.0.0-tp2-SNAPSHOT</version>
    </parent>

    <artifactId>validator</artifactId>
    <version>2.0.0-tp2-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>KoSIT Validator distribution</name>

    <description>
        The release distribution: the two runnable jars at the top, everything they need below libs/. This module exists
        because an aggregator is built before its modules.
    </description>

    <dependencies>
        <!-- the command line application, with its runtime dependencies; they go to libs/ -->
        <dependency>
            <groupId>org.kosit</groupId>
            <artifactId>validator-cli</artifactId>
            <version>${version.validator}</version>
        </dependency>
        <!--
            the server as the Quarkus runner: it carries its runtime inside, so its dependencies are deliberately
            excluded - resolving them would fill libs/ with jars that nothing on the class path ever loads
        -->
        <dependency>
            <groupId>org.kosit</groupId>
            <artifactId>validator-server</artifactId>
            <version>${version.validator}</version>
            <classifier>runner</classifier>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build> 
    
        <finalName>validator-${version.validator}</finalName>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <executions>
                    <execution>
                        <id>distribution</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <descriptors>
                                <descriptor>${project.basedir}/src/assembly/assembly-distribution.xml</descriptor>
                            </descriptors>
                            <appendAssemblyId>false</appendAssemblyId>
                            <!-- the name the release job of .gitlab-ci.yml deploys -->

                            <!-- Registers the assembled artifact with Maven so it gets deployed/published along with your main JAR. 
                                 ZIP becomes part of your release artifacts
                            -->
                            <attach>true</attach>
   
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
