<?xml version="1.0" encoding="UTF-8" standalone="yes"?>

<jaxb:bindings
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:xjc="http://java.sun.com/xml/ns/jaxb/xjc"
    xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb"
    xmlns:simplify="urn:jaxb.jvnet.org:plugin:simplify"
    jaxb:extensionBindingPrefixes="simplify xjc"
    version="3.0">

    <jaxb:globalBindings>
        <xjc:serializable uid="-1"/>
        <xjc:javaType
                name="java.lang.String"
                xmlType="xs:string"
                adapter="org.kosit.jaxb.adapter.StringTrimAdapter"/>
        <xjc:javaType
                name="java.lang.Long"
                xmlType="xs:integer" adapter="org.kosit.jaxb.adapter.LongAdapter"/>
    </jaxb:globalBindings>

    <jaxb:bindings schemaLocation="../../resources/xsd/xvrl-1.0.xsd">

        <jaxb:schemaBindings>
            <jaxb:package name="org.kosit.xvrl.jaxb"/>
        </jaxb:schemaBindings>

        <jaxb:bindings node="//xs:complexType[@name='XvrlDetectionType']">
            <jaxb:bindings node="xs:choice">
                 <simplify:as-element-property/>
            </jaxb:bindings>
        </jaxb:bindings>

        <jaxb:bindings node="//xs:complexType[@name='XvrlMetadataType']">
            <jaxb:bindings node="xs:choice">
                <simplify:as-element-property/>
            </jaxb:bindings>
        </jaxb:bindings>

        <jaxb:bindings node="//xs:simpleType[@name='XvrlSeverityType']">
            <jaxb:typesafeEnumClass />
        </jaxb:bindings>
    </jaxb:bindings>

</jaxb:bindings>
