<?xml version="1.0" encoding="UTF-8"?>

<scenarios xmlns="http://www.xoev.de/de/validator/framework/2/scenarios" frameworkVersion="2.0.0">
    <name>Scenario written for 2.0</name>
    <author>QA</author>
    <date>2026-09-08</date>
    <description>
        <p>A scenario as 2.0 configurations write it: the Schematron processor named at the rule set, customLevel below
            validateWithSchematron, no createReport, acceptMatch kept but empty, coordinates on the scenario and on
            every artifact.</p>
    </description>

    <scenario id="org.kosit.validator.test:simple:1.0.0">
        <name>Simple</name>
        <namespace prefix="test">http://validator.kosit.de/test-sample</namespace>
        <match>/test:simple</match>
        <validateWithXmlSchema>
            <resource id="org.kosit.validator.test:simple-xsd:1.0.0">
                <name>Sample Schema</name>
                <location>simple.xsd</location>
            </resource>
        </validateWithXmlSchema>
        <validateWithSchematron compiler="schxslt">
            <resource id="org.kosit.validator.test:simple-rules:1.0.0:compiled">
                <name>Sample Schematron</name>
                <location>simple.xsl</location>
            </resource>
            <customLevel level="warning">rejected</customLevel>
        </validateWithSchematron>
        <acceptMatch/>
    </scenario>

</scenarios>
