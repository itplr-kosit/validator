<?xml version="1.0" encoding="UTF-8"?>

<!--
  The same scenario as scenarios-accept-match-empty.xml, written in configuration version 3: the coordinates are
  structured instead of one id attribute, and the scenario says it validates XML. Both must load into the same model
  and produce the same verdict - that is what ConfigurationLoaderTest checks.
-->
<scenarios xmlns="urn:kosit:validator:scenario:3">
    <name>Scenario written for 2.0</name>
    <author>QA</author>
    <lastModificationDate>2026-09-08</lastModificationDate>
    <description>
        <p>The version 3 twin of scenarios-accept-match-empty.xml.</p>
    </description>

    <scenarioXml>
        <groupId>org.kosit.validator.test</groupId>
        <artifactId>simple</artifactId>
        <version>1.0.0</version>
        <name>Simple</name>
        <namespace prefix="test">http://validator.kosit.de/test-sample</namespace>
        <match>/test:simple</match>
        <validateWithXmlSchema>
            <resource>
                <groupId>org.kosit.validator.test</groupId>
                <artifactId>simple-xsd</artifactId>
                <version>1.0.0</version>
                <name>Sample Schema</name>
                <location>simple.xsd</location>
            </resource>
        </validateWithXmlSchema>
        <validateWithSchematron compiler="schxslt">
            <resource>
                <groupId>org.kosit.validator.test</groupId>
                <artifactId>simple-rules</artifactId>
                <version>1.0.0</version>
                <classifier>compiled</classifier>
                <name>Sample Schematron</name>
                <location>simple.xsl</location>
            </resource>
            <customLevel level="warning">rejected</customLevel>
        </validateWithSchematron>
    </scenarioXml>

</scenarios>
