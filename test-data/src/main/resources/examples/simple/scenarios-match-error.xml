<?xml version="1.0" encoding="UTF-8"?>

<scenarios xmlns="http://www.xoev.de/de/validator/framework/2/scenarios" frameworkVersion="2.0.0">
    <name>HTML-TestSuite</name>
    <author>QA</author>
    <date>2017-08-08</date>
    <description>
        <p>Szenario für Tests</p>
    </description>

    <scenario>
        <name>Simple</name>
        <description>
            <p>Der Match kompiliert, scheitert aber an diesem Dokument: der Text von test:inner ist keine Zahl.</p>
        </description>
        <namespace prefix="test">http://validator.kosit.de/test-sample</namespace>
        <match>xs:integer(/test:simple/test:inner) = 1</match>

        <validateWithXmlSchema>
            <resource>
                <name>Sample Schema</name>
                <location>simple.xsd</location>
            </resource>
        </validateWithXmlSchema>
    </scenario>
</scenarios>
