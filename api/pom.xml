<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.kosit</groupId>
        <artifactId>validator</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <packaging>jar</packaging>
    <artifactId>validator-api</artifactId>
    
    <dependencies>
        <dependency>
            <groupId>org.kosit</groupId>
            <artifactId>svrl</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.kosit</groupId>
            <artifactId>xvrl</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.kosit</groupId>
            <artifactId>scenario</artifactId>
            <version>${project.version}</version>
        </dependency>
        
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    
    <build>
        <resources>
            <resource>
                <directory>src/main/model</directory>
            </resource>
        </resources>
        
        <plugins>
            <!-- Generate model classes -->
            <plugin>
                <groupId>org.jvnet.jaxb</groupId>
                <artifactId>jaxb-maven-plugin</artifactId>
                <version>${version.jaxb-maven-plugin}</version>
                <executions>
                    <execution>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <extension>true</extension>
                    <strict>false</strict>
                    <schemaDirectory>src/main/model/xsd</schemaDirectory>
                    <bindingDirectory>src/main/model/binding</bindingDirectory>
                    <catalog>src/main/model/binding/catalog.txt</catalog>
                    <!--generateDirectory>${project.build.directory}/generated-sources/xjc</generateDirectory-->
                    <packageLevelAnnotations>false</packageLevelAnnotations>
                    <args>
                        <arg>-Xinheritance</arg>
                        <arg>-Xsimplify</arg>
                        <arg>-Xsimplify-usePluralForm=true</arg>
                    </args>
                    <!-- Reuse the SVRL and scenario JAXB classes generated in the respective modules instead of regenerating them. -->
                    <episodes>
                        <episode>
                            <groupId>org.kosit</groupId>
                            <artifactId>svrl</artifactId>
                        </episode>
                        <episode>
                            <groupId>org.kosit</groupId>
                            <artifactId>scenario</artifactId>
                        </episode>
                    </episodes>
                    <plugins>
                        <plugin>
                            <groupId>org.jvnet.jaxb</groupId>
                            <artifactId>jaxb-plugins</artifactId>
                            <version>${version.jaxb-maven-plugin}</version>
                        </plugin>
                    </plugins>
                </configuration>
            </plugin>
            <!-- For every element referenced from an imported schema, XJC emits a stub ObjectFactory into the
                 owning package, even though that package is covered by an episode. Those stubs would shadow the
                 complete ObjectFactory of the svrl and scenario modules on the classpath. They are not needed here,
                 because -Xsimplify turns all element references into plain @XmlElement properties. -->
            <!-- Delete the directory with only ObjectFactory 
                 Source: http://stackoverflow.com/questions/32635137
            -->
            <plugin>
              <artifactId>maven-antrun-plugin</artifactId>
              <executions>
                <execution>
                  <phase>process-sources</phase>
                  <goals>
                    <goal>run</goal>
                  </goals>
                  <configuration>
                    <target>
                      <delete dir="${basedir}/target/generated-sources/xjc/org/oclc/" />
                      <delete dir="${basedir}/target/generated-sources/xjc/org/kosit/validator/scenario/" />
                    </target>
                  </configuration>
                </execution>
              </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <!-- Embed CycloneDX SBOM in the deployable jar (config inherited from parent pluginManagement). -->
            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
