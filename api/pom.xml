<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.kosit</groupId>
        <artifactId>validator</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <packaging>jar</packaging>
    <artifactId>validator-api</artifactId>
    
    <dependencies>
        <dependency>
            <groupId>org.kosit</groupId>
            <artifactId>svrl</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.kosit</groupId>
            <artifactId>xvrl</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>
    
    <build>
        <resources>
            <resource>
                <directory>src/main/model</directory>
            </resource>
        </resources>
        
        <plugins>
            <!-- Generate model classes -->
            <plugin>
                <groupId>org.jvnet.jaxb</groupId>
                <artifactId>jaxb-maven-plugin</artifactId>
                <version>${version.jaxb-maven-plugin}</version>
                <executions>
                    <execution>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <extension>true</extension>
                    <strict>false</strict>
                    <schemaDirectory>src/main/model/xsd</schemaDirectory>
                    <bindingDirectory>src/main/model/binding</bindingDirectory>
                    <catalog>src/main/model/binding/catalog.txt</catalog>
                    <!--generateDirectory>${project.build.directory}/generated-sources/xjc</generateDirectory-->
                    <packageLevelAnnotations>false</packageLevelAnnotations>
                    <args>
                        <arg>-Xinheritance</arg>
                        <arg>-Xsimplify</arg>
                        <arg>-Xsimplify-usePluralForm=true</arg>
                    </args>
                    <!-- Reuse the SVRL JAXB classes generated in the svrl module instead of regenerating them. -->
                    <episodes>
                        <episode>
                            <groupId>org.kosit</groupId>
                            <artifactId>svrl</artifactId>
                        </episode>
                    </episodes>
                    <plugins>
                        <plugin>
                            <groupId>org.jvnet.jaxb</groupId>
                            <artifactId>jaxb-plugins</artifactId>
                            <version>${version.jaxb-maven-plugin}</version>
                        </plugin>
                    </plugins>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <!-- Embed CycloneDX SBOM in the deployable jar (config inherited from parent pluginManagement). -->
            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
