<jaxb:bindings
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:xjc="http://java.sun.com/xml/ns/jaxb/xjc"
    xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb"
    xmlns:inheritance="urn:jaxb.jvnet.org:plugin:inheritance"
    xmlns:simplify="http://jaxb2-commons.dev.java.net/basic/simplify"
    jaxb:extensionBindingPrefixes="inheritance"
    version="3.0">

    <jaxb:globalBindings>
        <xjc:serializable uid="-1"/>
        <xjc:javaType
                name="java.lang.String"
                xmlType="xs:string"
                adapter="de.kosit.validationtool.impl.xml.StringTrimAdapter"/>
        <xjc:javaType
                name="java.lang.Long"
                xmlType="xs:integer" adapter="de.kosit.validationtool.impl.xml.LongAdapter"/>
    </jaxb:globalBindings>

    <jaxb:bindings schemaLocation="../xsd/model.xsd">
        <jaxb:schemaBindings>
            <jaxb:package name="de.kosit.validationtool.model"/>
        </jaxb:schemaBindings>
        <jaxb:bindings node="//xs:complexType[@name='XMLSyntaxError']">
            <inheritance:extends>de.kosit.validationtool.impl.model.BaseXMLSyntaxError</inheritance:extends>
        </jaxb:bindings>
    </jaxb:bindings>

    <jaxb:bindings schemaLocation="../xsd/scenarios.xsd">
        <jaxb:schemaBindings>
            <jaxb:package name="de.kosit.validationtool.model.scenarios"/>
        </jaxb:schemaBindings>
    </jaxb:bindings>

    <jaxb:bindings schemaLocation="../xsd/assertions.xsd">
        <jaxb:schemaBindings>
            <jaxb:package name="de.kosit.validationtool.cmd.assertions"/>
        </jaxb:schemaBindings>
    </jaxb:bindings>

    <jaxb:bindings schemaLocation="../xsd/svrl-kosit.xsd">
        <jaxb:bindings node="//xs:element[@name='schematron-output']/xs:complexType">
            <inheritance:extends>de.kosit.validationtool.impl.model.BaseOutput</inheritance:extends>
        </jaxb:bindings>
    </jaxb:bindings>

    <jaxb:bindings schemaLocation="../xsd/daemon.xsd">
        <jaxb:schemaBindings>
            <jaxb:package name="de.kosit.validationtool.model.daemon"/>
        </jaxb:schemaBindings>
    </jaxb:bindings>
    <jaxb:bindings schemaLocation="../xsd/xvrl.xsd">

        <jaxb:schemaBindings>
            <jaxb:package name="de.kosit.validationtool.model.xvrl"/>
        </jaxb:schemaBindings>


        <jaxb:bindings node="//xs:element[@name='reportSummary']">
            <jaxb:class name="XVRLReportSummary"/>

            <inheritance:implements>de.kosit.validationtool.impl.xvrl.BaseReportSummary</inheritance:implements>

            <simplify:property name="reportOrReportSummaryOrDigest">
                <simplify:as-element-property/>
            </simplify:property>
        </jaxb:bindings>

        <jaxb:bindings node="//xs:element[@name='report']">
            <jaxb:class name="XVRLReport"/>
            <inheritance:extends>de.kosit.validationtool.impl.xvrl.BaseReport</inheritance:extends>
        </jaxb:bindings>

        <jaxb:bindings node="//xs:element[@name='detection']">
            <jaxb:class name="XVRLDetection"/>
            <inheritance:implements>de.kosit.validationtool.impl.xvrl.BaseDetection</inheritance:implements>

            <simplify:property name="locationOrProvenanceOrTitle">
                <simplify:as-element-property/>
            </simplify:property>
        </jaxb:bindings>

        <jaxb:bindings node="//xs:element[@name='metadata']">
            <jaxb:class name="XVRLMetadata"/>

            <simplify:property name="timestampOrValidatorOrCreator">
                <simplify:as-element-property/>
            </simplify:property>
        </jaxb:bindings>

        <jaxb:bindings node="//xs:element[@name='digest']">
            <jaxb:class name="XVRLDigest"/>
        </jaxb:bindings>

        <jaxb:bindings node="//xs:element[@name='message']">
            <jaxb:class name="XVRLMessage"/>
            <inheritance:implements>de.kosit.validationtool.impl.xvrl.BaseMessage</inheritance:implements>
        </jaxb:bindings>

        <jaxb:bindings node="//xs:attribute[@name='severity']/xs:simpleType">
            <jaxb:typesafeEnumClass name="Severity" />
        </jaxb:bindings>
    </jaxb:bindings>

</jaxb:bindings>