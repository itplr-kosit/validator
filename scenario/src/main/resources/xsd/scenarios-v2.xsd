<?xml version="1.0" encoding="UTF-8" ?>

<!-- $Id$ -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:s="http://www.xoev.de/de/validator/framework/2/scenarios"
           targetNamespace="http://www.xoev.de/de/validator/framework/2/scenarios" version="2.0.0"
           elementFormDefault="qualified" attributeFormDefault="unqualified">

    <xs:element name="scenarios">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="name" type="xs:token"/>
                <xs:element minOccurs="0" name="author" type="xs:token"/>
                <xs:element name="date" type="xs:date"/>
                <xs:element name="description" type="s:DescriptionType"/>
                <xs:element ref="s:scenario" minOccurs="1" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:attribute name="frameworkVersion" type="xs:string" use="required" />
        </xs:complexType>
    </xs:element>

    <xs:element name="scenario" type="s:ScenarioType" />


    <xs:complexType name="DescriptionType">
        <xs:choice maxOccurs="unbounded">
            <xs:element name="p" type="xs:normalizedString" />
            <xs:element name="ol">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element maxOccurs="unbounded" name="li" type="xs:normalizedString" />
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="ul">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element maxOccurs="unbounded" name="li" type="xs:normalizedString" />
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:choice>
    </xs:complexType>

    <!-- TODO: Prüfen, ob restriction passt -->
    <xs:simpleType name="ErrorLevelType">
        <xs:restriction base="xs:token">
            <xs:enumeration value="error" />
            <xs:enumeration value="warning" />
            <xs:enumeration value="information" />
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="Tokens">
        <xs:list itemType="xs:token" />
    </xs:simpleType>

    <xs:simpleType name="CoordinateType">
        <xs:annotation>
            <xs:documentation>
                A Maven-like coordinate group:artifact:version with an optional fourth part as classifier, e.g.
                "eu.cen.en16931:en16931-ubl-validation:1.3.15" or "de.xeinkauf:xrechnung-3.0.2-schematron:2.5.0:ubl".
                Each part carries letters, digits, underscore, hyphen and dot, at most 64 characters; the version part
                is expected to name an exact version, so that a configuration states which version of an artifact it
                was written for. Compare "Artifact Addressing" of the conformatron rule repository specification and
                the DVR coordinate of ph-diver.
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:token">
            <xs:pattern value="[a-zA-Z0-9_\-\.]{1,64}:[a-zA-Z0-9_\-\.]{1,64}:[a-zA-Z0-9_\-\.]{1,64}(:[a-zA-Z0-9_\-\.]{1,64})?" />
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="ScenarioType">
        <xs:sequence>
            <xs:element name="name" type="xs:token" />
            <xs:element minOccurs="0" name="description" type="s:DescriptionType" />
            <xs:element minOccurs="0" maxOccurs="unbounded" name="namespace" type="s:NamespaceType" />
            <xs:element name="match" type="xs:string" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>
                        An XPath expression over the document; the scenario applies when it is true. A scenario without
                        match applies unconditionally, in addition to the scenario detected by its match. That is the shape
                        of a scenario assembled at runtime from validation artifacts; a declared scenario should normally
                        carry a match.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="validateWithXmlSchema" type="s:ValidateWithXmlSchema" minOccurs="0" />
            <xs:element name="validateWithSchematron" maxOccurs="unbounded" minOccurs="0" type="s:ValidateWithSchematron" />
            <xs:element name="acceptMatch" type="xs:string" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>
                        Kept from 1.x, not evaluated by 2.0: the decision is computed from the conformance statements of the
                        rule sets. Configurations written for 2.0 leave the element empty.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
        <xs:attribute name="id" type="s:CoordinateType">
            <xs:annotation>
                <xs:documentation>
                    Optional: the id of the validation requirement this scenario stands for, as a coordinate, e.g.
                    "de.xeinkauf.xrechnung:ubl-invoice:3.0.2". Declared so that a report states which requirement was
                    applied, not only its display name. Deliberately not xs:ID: a coordinate carries colons and is no
                    NCName, and the id is unique per configuration by convention, not by schema. The engine still
                    identifies a scenario by its name (cvr:scenario-id), so the id is documentation until the scenario
                    configuration of version 2 makes it the identifier.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <xs:element name="resource" type="s:ResourceType" />

    <xs:complexType name="NamespaceType">
        <xs:simpleContent>
            <xs:extension base="xs:anyURI">
                <xs:attribute name="prefix" use="required" />
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <xs:complexType name="ResourceType">
        <xs:sequence>
            <xs:element name="name" type="xs:token" />
            <xs:element name="location" type="xs:anyURI" />
        </xs:sequence>
        <xs:attribute name="id" type="s:CoordinateType">
            <xs:annotation>
                <xs:documentation>
                    Optional: the id of this validation artifact, a coordinate, e.g.
                    "de.xeinkauf:xrechnung-3.0.2-schematron:2.5.0:ubl". It states which artifact in which exact version
                    the configuration was written for, while the location says where that version lies in the artifact
                    repository. The declaration travels into the report: step 4 embeds the applied scenario, so a
                    consumer reads the coordinate next to the location and the digest of the bytes that were actually
                    retrieved (step 5).
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <xs:complexType name="ValidateWithXmlSchema">
        <xs:sequence>
            <xs:element ref="s:resource" maxOccurs="unbounded" />
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ValidateWithSchematron">
        <xs:sequence>
            <xs:element ref="s:resource" />
            <xs:element maxOccurs="unbounded" minOccurs="0" name="customLevel" type="s:CustomErrorLevel">
                <xs:annotation>
                    <xs:documentation>
                        Optional: rule codes of this rule set whose severity the configuration overrides, declared with the
                        rule set they belong to (1.x declared them below the report transformation, which 2.0 does not have).
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
        <xs:attribute name="psvi" type="xs:boolean" default="false" use="optional" />
        <xs:attribute name="compiler" type="xs:string">
            <xs:annotation>
                <xs:documentation>
                    Optional: id of the Schematron processor of this rule set (e.g. schxslt, schxslt2, iso-schematron). For a
                    .sch it is the processor the validator compiles it with; for a precompiled .xsl it names the processor
                    that produced it, so the report can state how the rule set was built.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>


    <xs:complexType name="CustomErrorLevel">
        <xs:simpleContent>
            <xs:extension base="s:Tokens">
                <xs:attribute name="level" type="s:ErrorLevelType" use="required" />
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>
</xs:schema>
