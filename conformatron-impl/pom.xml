<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.kosit</groupId>
        <artifactId>validator-parent</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>validator-conformatron-impl</artifactId>
    <name>Conformatron implementation</name>
    <description>The canonical pipeline steps of the Conformatron API as the validator implements them, and the writer of the Conformance Validation Report. Knows no scenario configuration: detecting and selecting a scenario is left to validator-core.</description>

    <dependencies>
        <dependency>
            <groupId>${project.parent.groupId}</groupId>
            <artifactId>validator-conformatron-model</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.parent.groupId}</groupId>
            <artifactId>validator-base</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.parent.groupId}</groupId>
            <artifactId>validator-jaxb</artifactId>
        </dependency>
        <!-- parse-document -->
        <dependency>
            <groupId>${project.parent.groupId}</groupId>
            <artifactId>validator-xml</artifactId>
        </dependency>
        <!-- prepare-rules and apply-rules -->
        <dependency>
            <groupId>${project.parent.groupId}</groupId>
            <artifactId>validator-schematron</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.parent.groupId}</groupId>
            <artifactId>validator-svrl</artifactId>
        </dependency>
        <!-- the report: XVRL and its CVR profile -->
        <dependency>
            <groupId>${project.parent.groupId}</groupId>
            <artifactId>validator-xvrl</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.parent.groupId}</groupId>
            <artifactId>validator-cvr</artifactId>
        </dependency>
        <dependency>
            <groupId>net.sf.saxon</groupId>
            <artifactId>Saxon-HE</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.parent.groupId}</groupId>
            <artifactId>validator-base</artifactId>
            <version>${version.validator}</version>
            <scope>test</scope>
            <classifier>tests</classifier>
        </dependency>
        <dependency>
            <groupId>${project.parent.groupId}</groupId>
            <artifactId>validator-test-data</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
